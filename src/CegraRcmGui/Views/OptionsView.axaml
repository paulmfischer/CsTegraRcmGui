<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CegraRcmGui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="CegraRcmGui.Views.OptionsView"
             x:DataType="vm:OptionsViewModel">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Options" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

        <CheckBox Content="Auto-inject when a favorite is selected or the device is plugged in" IsChecked="{Binding AutoInject}" />
        <CheckBox Content="Enable logging" IsChecked="{Binding LoggingEnabled}" />
    </StackPanel>
</UserControl>
