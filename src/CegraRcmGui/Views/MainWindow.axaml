<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CegraRcmGui.ViewModels"
        xmlns:views="using:CegraRcmGui.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="CegraRcmGui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="800" Height="500"
        Title="CegraRcmGui">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl>
        <TabItem Header="Payload">
            <views:PayloadView DataContext="{Binding Payload}" />
        </TabItem>
        <TabItem Header="Tools">
            <views:ToolsView DataContext="{Binding Tools}" />
        </TabItem>
        <TabItem Header="Options">
            <views:OptionsView DataContext="{Binding Options}" />
        </TabItem>
    </TabControl>

</Window>
