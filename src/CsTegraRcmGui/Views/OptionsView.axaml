<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CsTegraRcmGui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="CsTegraRcmGui.Views.OptionsView"
             x:DataType="vm:OptionsViewModel">

    <StackPanel Margin="16" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Log file" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LogFilePath}" TextWrapping="Wrap" />
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</UserControl>
